# Copie este ficheiro para .env. Nunca coloque segredos no frontend nem no GitHub.
DATABASE_PATH=./data/rsvps.sqlite3
# A área de administração só funciona depois de configurar as duas variáveis:
ADMIN_PASSWORD=SUBSTITUIR_POR_PALAVRA_PASSE_FORTE
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=SUBSTITUIR_POR_CHAVE_ALEATORIA_COM_MAIS_DE_32_CARACTERES

# WhatsApp Business Cloud API (Meta). Opcional até à activação.
# Precisa de: conta WhatsApp Business Platform, remetente autorizado,
# template 'novo_rsvp_dulce' aprovado no idioma pt_PT e consentimento da destinatária.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=novo_rsvp_dulce
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
WHATSAPP_GRAPH_VERSION=v27.0
WHATSAPP_TO=258877697751
